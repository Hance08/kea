[Unit]
Description=Kea personal accounting server
After=network.target

[Service]
Type=simple
User=kea
Group=kea
ExecStart=/usr/local/bin/kea serve
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kea/.config/kea
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
